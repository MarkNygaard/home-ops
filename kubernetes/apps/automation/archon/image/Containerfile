# Custom Archon image with a real C toolchain (gcc + libc dev headers).
#
# Upstream ghcr.io/coleam00/archon ships zero C toolchain, which breaks any
# cargo build that links system C libs (openssl-sys, sqlx, ring, rocksdb,
# etc.). Pre-baking build-essential here means the in-container `cc` is
# /usr/bin/gcc, so Rust's default GNU target triples Just Work — no per-run
# wrapper scripts, no Zig.
#
# Upstream only publishes :latest (no per-release tags — see archon.diy
# Docker docs). We digest-pin so builds are reproducible; Renovate's
# `dockerfile` manager auto-bumps the digest when :latest moves.

FROM ghcr.io/coleam00/archon:latest@sha256:f4ad1464a3a3efbdb7bd6476d215c0da45bf00fcc8fdc18825c9989c00e6bac6

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

USER appuser
